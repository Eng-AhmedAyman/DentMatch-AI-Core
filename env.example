# ==============================================================================
# FILE: .env.example
# DESCRIPTION: Copy this file to .env and fill in your actual values.
#              NEVER commit your real .env file to GitHub.
#
# SETUP:
#   cp .env.example .env
#   Then edit .env with your actual keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini API Key
# Get yours from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# HuggingFace Token (only needed if models are hosted on HuggingFace Hub)
# Get yours from: https://huggingface.co/settings/tokens
# ------------------------------------------------------------------------------
HF_TOKEN=your_huggingface_token_here
