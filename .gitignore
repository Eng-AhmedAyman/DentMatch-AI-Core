# 1. Ignore Data Folders (Too heavy & shouldn't be shared publicly)
data/stage1_binary/
data/stage3_disease/
data/test_samples/*
!data/test_samples/.keep

# 2. Ignore Dynamic Reports (Keep the folders, ignore the files inside)
reports/logs/*.txt
reports/patient_results/*.json
!reports/patient_results/.keep
!reports/logs/.keep

# 3. Python Cache (Junk files generated by Python)
__pycache__/
*.pyc
*.pyo

# 4. Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# 5. Virtual Environments (If you created one inside the folder)
venv/
env/
.conda/

# 6. Heavy Machine Learning Models & Checkpoints
# GitHub blocks files > 100MB. Ignore checkpoints and logs.
*.h5
*.keras
*.pt
*.pth
checkpoints/
logs/
models/temp_*

# 7. Environment Variables & Secrets (CRITICAL FOR SECURITY)
# Never push your passwords, API keys, or DB credentials!
.env
.env.local
secrets.toml

# 8. OS & Editor Junk Files
# Hides annoying hidden files created by Windows/Mac or VS Code
.DS_Store
Thumbs.db
.vscode/
.idea/

# 9. App Temporary Uploads (Streamlit/FastAPI)
# Ignore any images temporarily saved during testing the API or Dashboard
uploads/
temp_*.jpg
temp_*.png
patient_tooth.jpg