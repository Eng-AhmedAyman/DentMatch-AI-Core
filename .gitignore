# ==============================================================================
# .gitignore — HealthySmile AI Core
# ==============================================================================

# 1. Data — heavy & private
data/stage1_binary/
data/stage3_disease/

# 2. Python cache
__pycache__/
*.pyc
*.pyo

# 3. Jupyter checkpoints
.ipynb_checkpoints/

# 4. Virtual environments
venv/
env/
.conda/

# 5. Heavy model files (GitHub blocks >100MB — host on HuggingFace)
*.h5
*.keras
*.pt
*.pth
checkpoints/
models/stage1/
models/stage2/
models/stage3/
!models/stage1/.keep
!models/stage2/.keep
!models/stage3/.keep

# 6. Secrets — NEVER commit API keys
.env
.env.local
secrets.toml

# 7. OS & editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# 8. Temp files
uploads/
temp_*.jpg
temp_*.jpeg
temp_*.png
patient_tooth.jpg
patient_tooth.jpeg
patient_tooth.png

# 9. Logs & test cache
*.log
.pytest_cache/
logs/